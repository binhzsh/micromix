HF_TOKEN=

# Optional shared mount roots
MICROMIX_DATA_ROOT=./data

# MiniMax-Music3 (sglang-omni)
MINIMAX_MUSIC3_MODEL=MiniMaxAI/MiniMax-Music3
MINIMAX_MODEL_TYPE=diffusion
MINIMAX_BACKEND=diffusers
MINIMAX_NUM_GPUS=1
MINIMAX_ATTENTION_BACKEND=flashinfer
MINIMAX_DIT_CPU_OFFLOAD=false
MINIMAX_VAE_CPU_OFFLOAD=false
MINIMAX_TEXT_ENCODER_CPU_OFFLOAD=false
MINIMAX_SP_DEGREE=1
MINIMAX_CACHE_ROOT=/mnt/fast_pool/fast_models/micromix/minimax
MINIMAX_SHM_SIZE=32g
MINIMAX_GPU_COUNT=1
MINIMAX_API_TIMEOUT_SECONDS=1200

# MuScriptor
MUSICOR_MODEL=medium
MUSICOR_DEVICE=cuda
MUSICOR_CACHE_ROOT=/mnt/fast_pool/fast_models/micromix/muscriptor
MUSICOR_API_TIMEOUT_SECONDS=1200
MUSICOR_API_MAX_REQUEST_SIZE_MB=200

# musicator-api service
CORS_ORIGINS=*
